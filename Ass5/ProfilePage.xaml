<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ass5.ProfilePage"
             Title="Profile">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Profile" FontSize="28" FontAttributes="Bold" />

            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Enter name" />

            <Label Text="Surname" />
            <Entry Text="{Binding Surname}" Placeholder="Enter surname" />

            <Label Text="Email Address" />
            <Entry Text="{Binding EmailAddress}" Placeholder="Enter email" Keyboard="Email" />

            <Label Text="Bio" />
            <Editor Text="{Binding Bio}" Placeholder="Tell us about yourself" HeightRequest="110" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        HorizontalOptions="FillAndExpand" />
                <Button Text="Clear"
                        Command="{Binding ClearCommand}"
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <Label Text="{Binding StatusMessage}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
